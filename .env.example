# Скопируйте в .env. Скрипт scripts/init-env.sh создаёт случайный пароль сам.
POSTGRES_USER=nir
POSTGRES_DB=nir
POSTGRES_PASSWORD=replace_with_random_local_password
WEB_PORT=8080
# Только для будущих обработчиков авторизации; в каркасе они не подключены.
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
BOT_MODE=stub

# Модуль DeepSeek: стартовая конфигурация из ответа Александра от 01.11.2026.
# В каркасе модуль ещё не подключён; BOT_MODE остаётся stub.
# Ключ заполняйте только в локальном .env на сервере, не в Git и не во фронтенде.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Обычный режим / режим с рассуждением: точное значение сверить с парсером модуля.
# В ответе Александра формат значения не указан; до интеграции оставлено пустым.
DEEPSEEK_THINKING=
# Стартовый предел генерации; окончательное значение — после реальных измерений.
DEEPSEEK_MAX_TOKENS=8192
