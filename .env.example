# Скопируйте в .env. Скрипт scripts/init-env.sh создаёт случайный пароль сам.
POSTGRES_USER=nir
POSTGRES_DB=nir
POSTGRES_PASSWORD=replace_with_random_local_password
WEB_PORT=8080
# Только для будущих обработчиков авторизации; в каркасе они не подключены.
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
BOT_MODE=stub

# Модуль DeepSeek: конфигурация локального стенда.
# В каркасе модуль ещё не подключён; BOT_MODE остаётся stub.
# Ключ заполняйте только в локальном .env на сервере, не в Git и не во фронтенде.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# false для обычного режима, true для режима с рассуждением.
DEEPSEEK_THINKING=false
# Лимит стенда для прогонов от 06.11.2026.
DEEPSEEK_MAX_TOKENS=32768
